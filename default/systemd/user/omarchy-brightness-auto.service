[Unit]
Description=Set the display backlight from the ambient light sensor
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecCondition=/usr/bin/omarchy-brightness-auto --available
ExecStart=/usr/bin/omarchy-brightness-auto
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
