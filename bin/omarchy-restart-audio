#!/bin/bash

# omarchy:summary=Restart audio services and recover stuck USB audio devices.
# omarchy:examples=omarchy restart audio | omarchy-restart-audio

services=(wireplumber.service pipewire.service pipewire-pulse.service)
# The running shell belongs to the session, which may disagree with a caller
# opened after a dev link/unlink; omarchy-restart-shell resolves it the same way.
session_omarchy_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1)
: "${session_omarchy_path:=$OMARCHY_PATH}"
shell_config="$session_omarchy_path/shell"
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}

# From outside the session (e.g. over ssh), find Hyprland from its newest
# instance runtime dir, as omarchy-restart-shell does, so the lock state can
# be read.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hypr_dir=$(find "$runtime_dir/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
  [[ -n $hypr_dir ]] && export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}
fi
suspend_offset_before=""
sleep_inhibitor=""
shell_down=0
shell_lost=0

# Quickshell 0.3.1 on Qt 6.11 can crash when PipeWire or WirePlumber goes away
# under it (a delegate model reads a PipeWire node already deleted), and its
# crash handler brings the shell back with a crash report window and the
# screen locked. So audio services restart only while the screen is unlocked,
# with the shell stopped for just that long.

# One audio repair at a time, shared with the Apple audio watchdog: another
# restart could find the shell stopped for this one and restart audio again
# after it came back.
take_repair_lock() {
  mkdir -p "$runtime_dir"
  exec {repair_lock}>>"$runtime_dir/omarchy-audio-repair.lock"

  if ! flock -n "$repair_lock"; then
    echo "Not restarting audio: another audio repair is running. Try again in a minute." >&2
    exit 1
  fi
}

# Prints the number of running shell instances, or fails if Quickshell cannot
# tell. With none running, Quickshell answers in prose, even with -j.
shell_instances() {
  local listing

  listing=$(timeout 5s quickshell list -p "$shell_config" --any-display -j 2>/dev/null) || return 1

  if [[ $listing == "No running instances"* ]]; then
    echo 0
  else
    jq -e 'if type == "array" then length else error end' <<<"$listing" 2>/dev/null
  fi
}

# Prints why the shell must not be stopped now, or nothing if it may be. Only
# a shell that says the screen is neither locked nor locking may be stopped.
shell_stop_blocker() {
  local status
  local state

  omarchy-hyprland-session-locked
  case $? in
    0) echo "the screen is locked"; return ;;
    1) ;;
    *) echo "the lock state is unknown"; return ;;
  esac

  status=$(OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=3s omarchy-shell lock status 2>/dev/null)
  state=$(jq -r '
    if type != "object" then "unknown"
    elif .secure == true or .requested == true then "locked"
    elif .secure == false and .requested == false then "unlocked"
    else "unknown"
    end' <<<"$status" 2>/dev/null)

  case $state in
    unlocked) ;;
    locked) echo "the screen is locked" ;;
    *) echo "the lock state is unknown" ;;
  esac
}

stop_shell() {
  local attempt
  local count

  for (( attempt = 0; attempt < 10; attempt++ )); do
    timeout 5s quickshell kill -p "$shell_config" --any-display >/dev/null 2>&1
    count=$(shell_instances) && (( count == 0 )) && return 0
  done

  return 1
}

# CLOCK_BOOTTIME runs through a suspend and CLOCK_MONOTONIC does not.
suspend_offset() {
  python3 -c 'import time; print(time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic())'
}

# Nothing can lock the screen while the shell is stopped, so block sleep and
# wait until logind holds the block, which ends with this script even when it
# is killed. Closing the lid still suspends (logind ignores inhibitors for it
# by default), which restore_shell catches.
block_sleep() {
  local attempt

  systemd-inhibit --what=sleep --mode=block --who=omarchy-restart-audio \
    --why="The Omarchy shell is stopped while audio restarts" \
    tail --pid=$$ -f /dev/null >/dev/null 2>&1 {repair_lock}>&- &
  sleep_inhibitor=$!

  for (( attempt = 0; attempt < 30; attempt++ )); do
    if systemd-inhibit --list --no-legend --no-pager 2>/dev/null |
      awk -v pid="$sleep_inhibitor" '$1 == "omarchy-restart-audio" && $4 == pid { found = 1 } END { exit !found }'; then
      return 0
    fi
    kill -0 "$sleep_inhibitor" 2>/dev/null || break
    sleep 0.1
  done

  release_sleep
  return 1
}

release_sleep() {
  [[ -n $sleep_inhibitor ]] && kill "$sleep_inhibitor" 2>/dev/null
  sleep_inhibitor=""
}

# Asks the fresh shell to lock until it reports the lock secure; a fresh shell
# may refuse early requests while its lock plugin loads.
lock_screen() {
  local deadline=$((SECONDS + 30))
  local state

  while (( SECONDS < deadline )); do
    state=$(OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=3s omarchy-shell lock status 2>/dev/null |
      jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' 2>/dev/null)

    case $state in
      secure) return 0 ;;
      locking) ;;
      *) OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=3s omarchy-shell lock lock >/dev/null 2>&1 ;;
    esac

    sleep 0.5
  done

  return 1
}

# Starts the shell again, and locks the screen if the machine slept while no
# shell could lock it.
restore_shell() {
  local attempt
  local offset
  local restored=1

  for (( attempt = 0; attempt < 3; attempt++ )); do
    omarchy-restart-shell && restored=0 && break
    sleep 2
  done

  offset=$(suspend_offset)
  if ! awk -v before="$suspend_offset_before" -v after="$offset" 'BEGIN { exit !(after - before < 0.5) }'; then
    if ! lock_screen; then
      echo "The screen could not be locked after a suspend during the audio restart." >&2
      restored=1
    fi
  fi

  release_sleep
  shell_down=0
  if (( restored != 0 )); then
    echo "The Omarchy shell did not come back; run omarchy-restart-shell." >&2
    shell_lost=1
  fi
}

# An interrupted restart, or a closed terminal, must not strand the desktop
# without its shell.
on_exit() {
  local status=$?

  trap '' INT TERM HUP
  (( shell_down )) && restore_shell
  release_sleep
  (( shell_lost && status == 0 )) && status=1
  exit "$status"
}

# Runs a command, with the shell stopped around it when one runs. Refuses,
# touching nothing, while the screen is or may be locked.
with_shell_stopped() {
  local instances
  local blocker
  local status=0

  if ! instances=$(shell_instances); then
    echo "Not restarting audio: Quickshell cannot tell whether the Omarchy shell is running." >&2
    exit 1
  fi

  if (( instances == 0 )); then
    "$@"
    return
  fi

  blocker=$(shell_stop_blocker)
  if [[ -n $blocker ]]; then
    echo "Not restarting audio while $blocker: the Omarchy shell could crash. Unlock the screen and try again." >&2
    exit 1
  fi

  if ! block_sleep; then
    echo "Not restarting audio: sleep could not be blocked while the Omarchy shell is stopped." >&2
    exit 1
  fi

  suspend_offset_before=$(suspend_offset)
  shell_down=1
  echo -e "Stopping the Omarchy shell while audio restarts...\n"

  if ! stop_shell; then
    echo "Not restarting audio: the Omarchy shell could not be stopped." >&2
    exit 1
  fi

  "$@" || status=$?
  restore_shell
  (( status == 0 )) || return "$status"
  (( shell_lost == 0 ))
}

restart_audio_services() {
  echo -e "Restarting audio services...\n"

  if timeout 25s systemctl --user restart "${services[@]}"; then
    return 0
  fi

  echo -e "\nAudio services did not restart cleanly. Forcing stuck services down...\n"
  systemctl --user cancel >/dev/null 2>&1 || true
  systemctl --user kill --kill-whom=all --signal=KILL "${services[@]}" >/dev/null 2>&1 || true
  systemctl --user reset-failed "${services[@]}" >/dev/null 2>&1 || true

  timeout 25s systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service
}

wpctl_healthy() {
  timeout 5s wpctl status >/dev/null 2>&1
}

usb_device_for_card() {
  local card="$1"
  local path

  path=$(readlink -f "/sys/class/sound/card$card" 2>/dev/null) || return 1

  while [[ $path != "/" ]]; do
    if [[ -f $path/idVendor && -f $path/idProduct && -f $path/busnum && -f $path/devnum ]]; then
      basename "$path"
      return 0
    fi

    path=$(dirname "$path")
  done

  return 1
}

append_unique() {
  local value="$1"
  shift
  local existing

  [[ -z $value ]] && return

  for existing in "$@"; do
    [[ $existing == "$value" ]] && return
  done

  printf '%s\n' "$value"
}

audio_process_blocked_on_usb() {
  local pid
  local name
  local wchan

  for pid in /proc/[0-9]*; do
    [[ -r $pid/comm && -r $pid/wchan ]] || continue

    name=$(cat "$pid/comm" 2>/dev/null || true)
    [[ $name == "wireplumber" || $name == "pipewire" ]] || continue

    wchan=$(cat "$pid/wchan" 2>/dev/null || true)
    [[ $wchan == usb_* || $wchan == *usb* ]] && return 0
  done

  return 1
}

usb_audio_devices() {
  local card
  local device
  local devices=()
  local unique

  for card in /sys/class/sound/card*; do
    [[ -e $card && $card =~ /card([0-9]+)$ ]] || continue

    device=$(usb_device_for_card "${BASH_REMATCH[1]}" || true)
    unique=$(append_unique "$device" "${devices[@]}")
    [[ -n $unique ]] && devices+=("$unique")
  done

  printf '%s\n' "${devices[@]}"
}

clear_usb_audio_defaults() {
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wireplumber"

  [[ -d $state_dir ]] || return 0

  if [[ -f $state_dir/default-nodes ]]; then
    cp "$state_dir/default-nodes" "$state_dir/default-nodes.bak.$(date +%s)" 2>/dev/null || true
    sed -i \
      -e '/^default\.configured\.audio\.sink=alsa_output\.usb-/d' \
      -e '/^default\.configured\.audio\.sink\.[0-9]\+=alsa_output\.usb-/d' \
      "$state_dir/default-nodes" 2>/dev/null || true
  fi

  if [[ -f $state_dir/default-routes ]]; then
    cp "$state_dir/default-routes" "$state_dir/default-routes.bak.$(date +%s)" 2>/dev/null || true
    sed -i '/^alsa_card\.usb-/d' "$state_dir/default-routes" 2>/dev/null || true
  fi
}

stuck_usb_audio_devices() {
  local status
  local state
  local owner_pid
  local owner_name
  local card
  local device
  local devices=()
  local unique

  for status in /proc/asound/card*/pcm*p/sub*/status; do
    [[ -e $status ]] || continue

    state=$(awk '/^state:/ { print $2; exit }' "$status")
    [[ $state == "SETUP" ]] || continue

    owner_pid=$(awk '/^owner_pid[[:space:]]*:/ { print $3; exit }' "$status")
    [[ -n $owner_pid && -r /proc/$owner_pid/comm ]] || continue

    owner_name=$(cat "/proc/$owner_pid/comm" 2>/dev/null || true)
    [[ $owner_name == "wireplumber" || $owner_name == "pipewire" ]] || continue
    [[ $status =~ /card([0-9]+)/ ]] || continue

    card="${BASH_REMATCH[1]}"
    device=$(usb_device_for_card "$card" || true)
    unique=$(append_unique "$device" "${devices[@]}")
    [[ -n $unique ]] && devices+=("$unique")
  done

  printf '%s\n' "${devices[@]}"
}

reset_usb_audio_device() {
  local device="$1"
  local sysfs="/sys/bus/usb/devices/$device"
  local busnum
  local devnum
  local bus_device
  local product

  [[ -d $sysfs ]] || return 1

  if ! omarchy-cmd-present usbreset; then
    echo "usbreset is not installed; replug or power-cycle $device to recover it."
    return 1
  fi

  busnum=$(cat "$sysfs/busnum" 2>/dev/null) || return 1
  devnum=$(cat "$sysfs/devnum" 2>/dev/null) || return 1
  product=$(cat "$sysfs/product" 2>/dev/null || echo "$device")
  bus_device=$(printf '%03d/%03d' "$busnum" "$devnum")

  echo -e "\nResetting stuck USB audio device: $product ($bus_device)..."

  if timeout 25s sudo usbreset "$bus_device"; then
    return 0
  fi

  echo "Could not reset $product automatically. Replug or power-cycle it, then run omarchy-restart-audio again."
  return 1
}

recover_stuck_usb_audio() {
  local devices=()
  local device
  local detected=()
  local reset_count=0

  while IFS= read -r device; do
    [[ -n $device ]] && detected+=("$device")
  done < <(stuck_usb_audio_devices)

  if (( ${#detected[@]} == 0 )) && audio_process_blocked_on_usb; then
    echo "Audio service is blocked in USB I/O; resetting USB audio devices..."
    clear_usb_audio_defaults
    while IFS= read -r device; do
      [[ -n $device ]] && detected+=("$device")
    done < <(usb_audio_devices)
  fi

  for device in "${detected[@]}"; do
    [[ -n $(append_unique "$device" "${devices[@]}") ]] && devices+=("$device")
  done

  (( ${#devices[@]} > 0 )) || return 1

  for device in "${devices[@]}"; do
    reset_usb_audio_device "$device" && reset_count=$((reset_count + 1))
  done

  (( reset_count > 0 ))
}

# Capture the owned mapping gain before a healthy daemon is deliberately reset.
# A broken audio server must not prevent the existing recovery path.
if omarchy-hw-apple-silicon && omarchy-cmd-present omarchy-audio-asahi-mic-map; then
  if ! omarchy-audio-asahi-mic-map --save-state; then
    echo "Could not save microphone mapping gain before audio recovery." >&2
  fi
fi
take_repair_lock
trap on_exit EXIT
trap '' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
with_shell_stopped restart_audio_services || true

if ! wpctl_healthy; then
  echo -e "\nPipeWire is still not responding. Checking for stuck USB audio devices..."

  if recover_stuck_usb_audio; then
    echo -e "\nRestarting audio services after USB audio reset...\n"
    with_shell_stopped restart_audio_services || true
  else
    echo "No stuck USB audio device was detected automatically."
  fi
fi

sleep 2

echo -e "\nAudio status:\n"
if ! timeout 5s wpctl status; then
  echo "Audio services are still not responding. Try replugging or power-cycling the selected USB audio device."
  exit 1
fi
