#!/bin/bash

# omarchy:summary=Install Steam and graphics drivers selected for this system
# omarchy:requires-sudo=true

set -e

echo "Installing Steam..."
omarchy-pkg-add steam
omarchy-install-gaming-gpu-lib32

# A platform's setup adds what Steam needs there (on Apple Silicon, the FEX
# launcher and its desktop entry). The resolve is an assignment so an
# undetermined platform stops the install instead of skipping it.
entrypoint=$(omarchy-lifecycle-dispatch --resolve setup-system)
if [[ -n $entrypoint ]]; then
  sudo omarchy-lifecycle-dispatch setup-system
fi
omarchy-lifecycle-dispatch setup-user

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
