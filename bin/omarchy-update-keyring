#!/bin/bash

# omarchy:summary=Ensure the Omarchy and Arch keyring packages are installed and populated
# omarchy:requires-sudo=true

set -euo pipefail

trusted_key=40DFB630FF42BCFFB047046CF0134EE680CAC571
platform_keyrings_file=/usr/share/omarchy-platform/keyrings
platform_keyrings=(archlinux-keyring)
if omarchy-hw-apple-silicon; then
  platform_keyrings=(archlinuxarm-keyring)
  # A Mac whose omarchy-mac predates the platform's keyrings list.
  if [[ ! -e $platform_keyrings_file ]] && omarchy-pkg-present asahi-alarm-keyring; then
    platform_keyrings+=(asahi-alarm-keyring)
  fi
fi

# The platform package names the keyrings of the repositories it configures,
# such as [asahi-alarm] on a Mac. Only installed ones are refreshed: this never
# adds trust a machine didn't already have.
if [[ -e $platform_keyrings_file ]]; then
  while read -r keyring _ || [[ -n $keyring ]]; do
    [[ -n $keyring && $keyring != \#* ]] || continue
    if [[ ! $keyring =~ ^[a-z0-9][a-z0-9@._+-]*-keyring$ ]]; then
      echo "Error: $platform_keyrings_file names an invalid keyring package: $keyring" >&2
      exit 1
    fi
    if omarchy-pkg-present "$keyring" && [[ " ${platform_keyrings[*]} " != *" $keyring "* ]]; then
      platform_keyrings+=("$keyring")
    fi
  done <"$platform_keyrings_file"
fi

# The rings a keyring package provides are the pacman-key import files it owns.
keyring_rings() {
  local package files file found

  for package in "$@"; do
    files=$(pacman -Qlq -- "$package") || return
    found=0
    for file in $files; do
      if [[ $file =~ ^/usr/share/pacman/keyrings/([^/]+)\.gpg$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        found=1
      fi
    done
    if (( ! found )); then
      echo "Error: $package provides no pacman keyring" >&2
      return 1
    fi
  done
}

rings=$(keyring_rings "${platform_keyrings[@]}")
mapfile -t platform_rings <<<"$rings"

# Restore installed trust and revocation metadata before fetching updates.
sudo pacman-key --populate "${platform_rings[@]}"
if ! omarchy-pkg-missing omarchy-keyring; then
  sudo pacman-key --populate omarchy
fi

if ! sudo pacman-key --list-keys "$trusted_key" >/dev/null 2>&1; then
  sudo pacman-key --recv-keys "$trusted_key" --keyserver keys.openpgp.org
fi
fingerprint=$(sudo gpg --homedir /etc/pacman.d/gnupg --batch --with-colons --fingerprint "$trusted_key" |
  awk -F: '$1 == "pub" { primary=1; next } primary && $1 == "fpr" { print $10; exit }')
if [[ $fingerprint != "$trusted_key" ]]; then
  echo "Error: Omarchy signing key does not match $trusted_key" >&2
  exit 1
fi
sudo pacman-key --lsign-key "$trusted_key"

# Keyring refresh precedes the full system upgrade. Reinstall even when the
# version is unchanged, since key material can change without a version bump.
echo "Update signing keys"
sudo pacman -Sy --noconfirm -- omarchy-keyring "${platform_keyrings[@]}"
# A new version can ship its keys under another ring name.
rings=$(keyring_rings "${platform_keyrings[@]}")
mapfile -t platform_rings <<<"$rings"
sudo pacman-key --populate omarchy "${platform_rings[@]}"
echo "Keys are correct"
