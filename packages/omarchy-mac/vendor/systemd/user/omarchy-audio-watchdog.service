[Unit]
Description=Restart audio when it stops responding
After=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecCondition=/usr/bin/omarchy-hw-apple-silicon
ExecStart=/usr/bin/omarchy-audio-watchdog --watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
