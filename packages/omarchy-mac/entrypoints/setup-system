#!/bin/bash -p

# omarchy-lifecycle-dispatch setup-system [image-first-boot]. The last hardware
# leaf runs this on every install and hardware rerun, and an image's first
# boot runs it with image-first-boot. omarchy-mac-setup-system needs no network
# and rebuilds no boot file, so both runs are the same. It re-checks the
# platform.

set -euo pipefail

if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != "image-first-boot" ]]; }; then
  echo "Usage: setup-system [image-first-boot]" >&2
  exit 2
fi
if (( EUID == 0 )); then
  # Root takes nothing from its caller's environment.
  exec /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/bin /usr/bin/omarchy-mac-setup-system
else
  # Unprivileged tests stage the package under a fixture root.
  root=${OMARCHY_MAC_ROOT:-}
  exec "$root/usr/bin/omarchy-mac-setup-system" ${root:+"$root"}
fi
